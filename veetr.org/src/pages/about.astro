---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MarkdownSection from '../components/MarkdownSection.astro';
import Newsletter from '../components/Newsletter.astro';
import { frontmatter, Content } from '../content/pages/about.md';
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <PageHero
    eyebrow={frontmatter.eyebrow}
    title={frontmatter.heroTitle}
    lead={frontmatter.heroLead}
    support={frontmatter.heroSupport}
    image="/img/jan-steering.jpg"
    imageAlt="Jan steering a sailboat"
  />

  <MarkdownSection Content={Content} />

  <section class="section section-muted">
    <div class="shell stats-row">
      <div><strong>100%</strong><span>Open source direction</span></div>
      <div><strong>Prague</strong><span>Project home</span></div>
      <div><strong>Water-tested</strong><span>Born from actual sailing</span></div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>
