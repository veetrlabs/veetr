---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MarkdownSection from '../components/MarkdownSection.astro';
import Newsletter from '../components/Newsletter.astro';
import { frontmatter, Content } from '../content/pages/contact.md';
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <PageHero
    compact
    eyebrow={frontmatter.eyebrow}
    title={frontmatter.heroTitle}
    lead={frontmatter.heroLead}
    support={frontmatter.heroSupport}
  />

  <MarkdownSection Content={Content} />

  <Newsletter id={2} title="Contact Veetr" text="Send a note about building, testing, contributing, or the certification roadmap." />

  <section class="section">
    <div class="shell contact-links">
      <a href="https://github.com/veetrlabs/veetr/discussions">Join GitHub Discussions</a>
      <a href="mailto:veetr@linhart.email">Email veetr@linhart.email</a>
    </div>
  </section>
</BaseLayout>
