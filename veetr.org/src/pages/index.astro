---
import BaseLayout from '../layouts/BaseLayout.astro';
import hardwareKit from '../assets/veetr-hardware-kit-v7.png';
import appDashboard from '../assets/veetr-tablet-phone-1024.png';
import raceEditor from '../assets/home-race-editor.jpg';
import raceMap from '../assets/home-race-map.jpg';
import { Image } from 'astro:assets';
import { frontmatter } from '../content/pages/home.md';

const paths = [
  {
    id: 'sailing-app', title: 'Sail with Veetr',
    text: 'Record a day on the water, join a race, and revisit your trips with the sailing app.',
    image: appDashboard, alt: 'Veetr app shown on tablet and phone', caption: 'Web instruments on tablet and phone',
    href: '/docs/mobile-apps/', action: 'Explore the app', guide: '/docs/race-skippers/', guideLabel: 'Racing with Veetr',
    note: 'Native apps are in testing on iPhone and Android.',
  },
  {
    id: 'run-a-race', title: 'Run a race',
    text: 'Bring your fleet together. Set the course, run heats, and publish the results.',
    image: raceEditor, alt: 'Veetr course editor with a start line and turning marks', caption: 'Course editor · local example',
    href: '/races/manage/', action: 'Manage races', guide: '/docs/race-referees/', guideLabel: 'Referee guide',
  },
  {
    id: 'veetr-vane', title: 'Meet Veetr Vane',
    text: 'Add wind, heading, and heel data with portable hardware designed to be built and repaired.',
    image: hardwareKit, alt: 'Veetr Vane unit with wind sensor, Bluetooth antenna, and GPS antenna', caption: 'Veetr Vane and sensors',
    href: '/get-your-veetr/', action: 'See the hardware', guide: '/docs/hardware/', guideLabel: 'Hardware guide',
    note: 'Open design available. Finished hardware is not sold yet.',
  },
  {
    id: 'follow-a-race', title: 'Follow a race',
    text: 'See the course, follow available live tracking, and check the results from shore.',
    image: raceMap, alt: 'Veetr race map showing start line A–B and numbered course marks', caption: 'Race map · illustrative boats',
    href: '/races/', action: 'Explore races', guide: '/docs/race-spectators/', guideLabel: 'Spectator guide',
  },
];
---

<BaseLayout title="Veetr" description={frontmatter.description} hero={frontmatter} ecosystemActions>
  <div class="home-paths">
    {paths.map(path => (
      <article class="home-path" id={path.id}>
        <figure>
          <div class="path-image">
            {path.id === 'run-a-race' ? (
              <div class="preview-tablet">
                <Image src={path.image} width={960} format="webp" alt={path.alt} loading="lazy" />
              </div>
            ) : path.id === 'follow-a-race' ? (
              <div class="preview-monitor">
                <div class="preview-monitor-bezel">
                  <div class="preview-monitor-screen">
                    <div class="preview-race-scene">
                    <Image src={path.image} width={960} format="webp" alt={path.alt} loading="lazy" />
                    <svg class="preview-boats" viewBox="0 0 1000 481" role="img" aria-label="Three illustrative boats sailing from the start toward mark 1">
                      <g transform="translate(471 346) rotate(-80) scale(.55)">
                        <path d="M0 18 L0 38" stroke="#1682bb" stroke-width="4" stroke-dasharray="5 5" opacity=".7" />
                        <path d="M0 -19 L10 11 Q0 23 -10 11 Z" fill="#147bc1" stroke="white" stroke-width="3" />
                      </g>
                      <g transform="translate(496 353) rotate(-77) scale(.55)">
                        <path d="M0 18 L0 38" stroke="#c95b22" stroke-width="4" stroke-dasharray="5 5" opacity=".7" />
                        <path d="M0 -19 L10 11 Q0 23 -10 11 Z" fill="#e87832" stroke="white" stroke-width="3" />
                      </g>
                      <g transform="translate(520 360) rotate(-76) scale(.55)">
                        <path d="M0 18 L0 38" stroke="#7854bb" stroke-width="4" stroke-dasharray="5 5" opacity=".7" />
                        <path d="M0 -19 L10 11 Q0 23 -10 11 Z" fill="#8858cf" stroke="white" stroke-width="3" />
                      </g>
                    </svg>
                    </div>
                    <span class="preview-map-credit">© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> · <a href="https://www.openseamap.org/">OpenSeaMap</a></span>
                  </div>
                </div>
                <div class="preview-monitor-stand" aria-hidden="true"></div>
              </div>
            ) : (
              <Image src={path.image} width={960} format="webp" alt={path.alt} loading="lazy" />
            )}
          </div>
          <figcaption>{path.caption}</figcaption>
        </figure>
        <div class="path-copy">
          <h2>{path.title}</h2>
          <p>{path.text}</p>
          {path.note && <p class="path-note">{path.note}</p>}
          <div class="path-links">
            <a class="button button-secondary" href={path.href}>{path.action} →</a>
            <a href={path.guide}>{path.guideLabel}</a>
          </div>
        </div>
      </article>
    ))}
  </div>
  <section class="section home-open" aria-labelledby="open-title">
    <h2 id="open-title">Built in the open.</h2>
    <p>Explore the guides, see how it works, and help shape what comes next.</p>
    <div class="open-links">
      <a href="/docs/">Read the documentation →</a>
      <a href="https://github.com/veetrlabs/veetr">Explore the source →</a>
    </div>
  </section>
</BaseLayout>
