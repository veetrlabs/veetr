---
const iosInstall = import.meta.env.PUBLIC_IOS_INSTALL_URL || '';
const androidInstall = import.meta.env.PUBLIC_ANDROID_INSTALL_URL || '';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="referrer" content="no-referrer"/><meta name="robots" content="noindex,nofollow"/><title>Join your race · Veetr</title></head>
<body><main><p class="brand">⛵ Veetr</p><h1 id="title">Your race invitation</h1><p id="race" role="status">Opening invitation…</p><p id="start"></p><a id="open" hidden>Open in Veetr</a><p id="phone-hint" hidden>Open this invitation on your iPhone or Android phone to connect it to your boat.</p><p>No account needed. In the app, press <strong>Ready to race</strong>. Your phone will wait for the referee before sharing your position.</p><section><h2>Need the app?</h2>{iosInstall ? <a href={iosInstall} rel="noreferrer">Download for iPhone</a> : <p>iPhone testing: ask your referee for the Veetr TestFlight invitation.</p>}{androidInstall ? <a href={androidInstall} rel="noreferrer">Download for Android</a> : <p>Android testing: ask your referee for the Veetr testing download.</p>}<p>After installing, return to your WhatsApp message or email and tap this same race invitation again.</p></section><p id="error" role="alert"></p></main></body></html>
<style>html{font:18px/1.6 system-ui;background:#0b1722;color:#e9eff5}main{max-width:32rem;margin:6vh auto;padding:24px}.brand{color:#a9defa;font-weight:700}h1{font-size:2.5rem;line-height:1.15}h2{font-size:1.25rem}a{display:block;background:#a9defa;color:#071a26;border-radius:12px;text-decoration:none;padding:16px;text-align:center;font-weight:700;margin:14px 0}a[hidden]{display:none}section{border-top:1px solid #344451;margin-top:30px;padding-top:16px}#error{color:#ffc9b6}</style>
<script>
 const token=location.pathname.split('/').filter(Boolean)[1];
 const title=document.querySelector('#title')!,race=document.querySelector('#race')!,start=document.querySelector('#start')!,error=document.querySelector('#error')!,open=document.querySelector<HTMLAnchorElement>('#open')!;
 const url=import.meta.env.VITE_SUPABASE_URL,key=import.meta.env.VITE_SUPABASE_ANON_KEY;
 if(!token||!/^[a-f0-9-]{72}$/.test(token)){race.textContent='Open the complete invitation link sent by your referee.';}
 else if(!url||!key){race.textContent='Invitations are temporarily unavailable. Please try again later.';}
 else {fetch(`${url}/rest/v1/rpc/preview_race_tracking_link`,{method:'POST',headers:{apikey:key,'Content-Type':'application/json'},body:JSON.stringify({token}),referrerPolicy:'no-referrer'}).then(async r=>{if(!r.ok)throw new Error('Unable to check this invitation. Please try again.');return r.json();}).then(info=>{if(!info?.valid){race.textContent='This invitation has expired or been revoked. Ask your referee for a new link.';return;}title.textContent=info.boatName;race.textContent=info.raceName;start.textContent=`Expected start: ${new Date(info.scheduledStart).toLocaleString(undefined,{dateStyle:"medium",timeStyle:"short"})}`;open.href=`veetr://join/${token}`;const mobile=/Android|iPhone|iPad|iPod/i.test(navigator.userAgent)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1);open.hidden=!mobile;document.querySelector<HTMLElement>('#phone-hint')!.hidden=mobile;}).catch(e=>{race.textContent='Invitation unavailable';error.textContent=e.message;});}
</script>
