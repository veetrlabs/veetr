---
import LanguageSelect from '../../../components/LanguageSelect.astro';
const iosInstall = import.meta.env.PUBLIC_IOS_INSTALL_URL || '';
const androidInstall = import.meta.env.PUBLIC_ANDROID_INSTALL_URL || '';
---
<!doctype html><html lang="cs"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="referrer" content="no-referrer"/><meta name="robots" content="noindex,nofollow"/><title>Připojit se k lodi · Veetr</title></head>
<body><main><LanguageSelect /><p class="brand">⛵ Veetr</p><h1 id="title">Pozvánka k lodi</h1><p id="race" role="status">Otevírání pozvánky…</p><p id="start"></p><a id="open" hidden>Otevřít v aplikaci Veetr</a><p id="phone-hint" hidden>Otevřete pozvánku na iPhonu nebo telefonu s Androidem a připojte jej k lodi.</p><p>Účet není potřeba. V aplikaci stiskněte <strong>Připraven závodit</strong>. Telefon počká na rozhodčího, než začne sdílet polohu.</p><section><h2>Potřebujete aplikaci?</h2>{iosInstall ? <a href={iosInstall} rel="noreferrer">Stáhnout pro iPhone</a> : <p>Testování na iPhonu: požádejte rozhodčího o pozvánku do Veetr TestFlight.</p>}{androidInstall ? <a href={androidInstall} rel="noreferrer">Stáhnout pro Android</a> : <p>Testování na Androidu: požádejte rozhodčího o odkaz ke stažení testovací verze aplikace Veetr.</p>}<p>Po instalaci se vraťte do zprávy ve WhatsAppu nebo e-mailu a znovu otevřete stejnou pozvánku k lodi.</p></section><p id="error" role="alert"></p></main></body></html>
<style>html{font:18px/1.6 system-ui;background:#0b1722;color:#e9eff5}main{max-width:32rem;margin:6vh auto;padding:24px}.brand{color:#a9defa;font-weight:700}h1{font-size:2.5rem;line-height:1.15}h2{font-size:1.25rem}a{display:block;background:#a9defa;color:#071a26;border-radius:12px;text-decoration:none;padding:16px;text-align:center;font-weight:700;margin:14px 0}a[hidden]{display:none}section{border-top:1px solid #344451;margin-top:30px;padding-top:16px}#error{color:#ffc9b6}</style>
<script>
 const token=location.pathname.split('/').filter(Boolean)[2];
 const title=document.querySelector('#title')!,race=document.querySelector('#race')!,start=document.querySelector('#start')!,error=document.querySelector('#error')!,open=document.querySelector<HTMLAnchorElement>('#open')!;
 const url=import.meta.env.VITE_SUPABASE_URL,key=import.meta.env.VITE_SUPABASE_ANON_KEY;
 if(!token||!/^[a-f0-9-]{72}$/.test(token)){race.textContent='Otevřete úplný odkaz pozvánky od rozhodčího.';}
 else if(!url||!key){race.textContent='Pozvánky jsou dočasně nedostupné. Zkuste to později.';}
 else {fetch(`${url}/rest/v1/rpc/preview_tracking_invitation`,{method:'POST',headers:{apikey:key,'Content-Type':'application/json'},body:JSON.stringify({token}),referrerPolicy:'no-referrer'}).then(async r=>{if(!r.ok)throw new Error('Pozvánku se nepodařilo ověřit. Zkuste to znovu.');return r.json();}).then(info=>{if(!info?.valid){race.textContent='Pozvánka vypršela nebo byla odvolána. Požádejte rozhodčího o nový odkaz.';return;}title.textContent=info.boatName;race.textContent=info.scope==='series'?info.seriesName:info.raceName;start.textContent=info.scope==='series'?"Jedna pozvánka pro všechny závody seriálu. Spárujte telefon jednou a pak si v aplikaci vyberte závod. Pokud Veetr pozvánku nerozpozná, aktualizujte jej.":`Očekávaný start: ${new Date(info.scheduledStart).toLocaleString("cs-CZ",{dateStyle:"medium",timeStyle:"short"})}`;open.href=`veetr://join/${token}`;const mobile=/Android|iPhone|iPad|iPod/i.test(navigator.userAgent)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1);open.hidden=!mobile;document.querySelector<HTMLElement>('#phone-hint')!.hidden=mobile;}).catch(e=>{race.textContent='Pozvánka není dostupná';error.textContent=e.message;});}
</script>
