---
const navItems = [
  { href: '/product/', label: 'Product' },
  { href: '/build/', label: 'Build' },
  { href: '/get-your-veetr/', label: 'Get Your Veetr' },
  { href: '/docs/', label: 'Docs' },
  { href: '/about/', label: 'About' },
];

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell header-shell">
    <a class="brand" href="/" aria-label="Veetr home">
      <img src="/img/veetr-logo.svg" alt="" width="40" height="40" />
      <span>Veetr</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span>
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main navigation">
      {navItems.map((item) => (
        <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="text-link" href="https://github.com/veetrlabs/veetr">GitHub</a>
      <a class="button button-small" href="https://app.veetr.org/">Live App</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('.site-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    nav?.classList.toggle('is-open', !isOpen);
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
    });
  });
</script>
