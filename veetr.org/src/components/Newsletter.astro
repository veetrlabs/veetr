---
import {siteLanguage} from '../i18n/site';
const cs = siteLanguage(Astro.url.pathname) === 'cs';
interface Props {
  id?: number;
  anchorId?: string;
  eyebrow?: string;
  title?: string;
  text?: string;
}

const {
  id = 1,
  anchorId,
  eyebrow = cs ? 'Novinky' : 'Newsletter',
  title = cs ? 'Sledujte projekt' : 'Follow the project',
  text = cs ? 'Dostávejte zprávy o stavbě, certifikaci a pokrocích komunity do e-mailu.' : 'Get build notes, certification updates, and community milestones in your inbox.',
} = Astro.props;
---

<section class="newsletter-band" id={anchorId}>
  <div class="shell newsletter-grid">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="form-panel" data-form-language={cs ? "cs" : "en"}>
      <script type="text/javascript" src={`https://m.veetr.com/form/generate.js?id=${id}`}></script>
    </div>
  </div>
</section>

<script>
  import { localizeForm } from '../i18n/forms';
  document.querySelectorAll<HTMLElement>('[data-form-language="cs"]').forEach(localizeForm);
</script>
