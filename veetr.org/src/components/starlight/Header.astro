---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import { Icon } from '@astrojs/starlight/components';

const hardwareLinks = [
  { href: '/get-your-veetr/', label: 'Get your Veetr' },
  { href: '/build/', label: 'Build your own' },
  { href: '/docs/', label: 'Docs' },
];
const navigationGroups = [
  { label: 'Hardware', links: hardwareLinks },
];
const pathname = Astro.url.pathname;
const isCurrent = (href: string) => pathname === href || (['/docs/', '/races/'].includes(href) && pathname.startsWith(href));
---

<div class="veetr-header">
  <SiteTitle />
  <nav class="desktop-links" aria-label="Main navigation">
    {navigationGroups.map((group) => (
      <details class:list={['nav-group', { active: group.links.some(({ href }) => pathname.startsWith(href)) }]}>
        <summary>{group.label} <span class="chevron" aria-hidden="true">⌄</span></summary>
        <div class="group-links">
          {group.links.map(({ href, label }) => (
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          ))}
        </div>
      </details>
    ))}
    <a href="/races/" aria-current={isCurrent('/races/') ? 'page' : undefined}>Race management</a>
    <a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>About</a>
    <div id="veetr-account-controls" class="account-menu-item"><a href="/account/" aria-current={isCurrent('/account/') ? 'page' : undefined}>Account</a></div>
  </nav>
  <div class="header-controls">
    <Search />
    <details class="mobile-menu">
      <summary aria-label="Site navigation">
        <Icon class="menu-icon" name="list-format" size="1.25rem" />
        <Icon class="close-icon" name="close" size="1.25rem" />
      </summary>
      <nav aria-label="Mobile navigation">
        {navigationGroups.map((group) => (
          <details class:list={['nav-group', { active: group.links.some(({ href }) => pathname.startsWith(href)) }]}>
            <summary>{group.label} <span class="chevron" aria-hidden="true">⌄</span></summary>
            <div class="group-links">
              {group.links.map(({ href, label }) => (
                <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
              ))}
            </div>
          </details>
        ))}
        <a href="/races/" aria-current={isCurrent('/races/') ? 'page' : undefined}>Race management</a>
        <a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>About</a>
        <div id="veetr-mobile-account-controls" class="account-menu-item"><a href="/account/" aria-current={isCurrent('/account/') ? 'page' : undefined}>Account</a></div>
      </nav>
    </details>
  </div>
</div>

<style>
  .veetr-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 100%; max-width: 76rem; margin-inline: auto; }
  .veetr-header :global(.site-title) { flex-shrink: 0; white-space: nowrap; overflow: visible; gap: .6rem; color: var(--sl-color-white); font-size: 1.4rem; font-weight: 750; }
  .veetr-header :global(.site-title img) { height: 2.25rem; width: 2.25rem; }
  .desktop-links, .header-controls { display: flex; align-items: center; gap: .4rem; }
  .header-controls { flex-shrink: 0; }
  .header-controls :global(site-search) { margin-inline: .2rem; }
  .desktop-links :global(a), .nav-group > summary { padding: .55rem .7rem; font-size: .9rem; font-weight: 550; text-decoration: none; color: var(--sl-color-gray-2); border-radius: .5rem; white-space: nowrap; }
  .desktop-links :global(a:hover), .desktop-links :global(a[aria-current="page"]), .nav-group > summary:hover, .nav-group.active > summary { color: var(--sl-color-text-accent); background: var(--sl-color-accent-low); }
  .nav-group { position: relative; }
  .nav-group > summary { display: flex; align-items: center; justify-content: space-between; gap: .5rem; cursor: pointer; list-style: none; }
  .nav-group > summary::-webkit-details-marker { display: none; }
  .chevron { transition: transform .15s; }
  .nav-group[open] > summary .chevron { transform: rotate(180deg); }
  .group-links { display: grid; gap: .2rem; }
  .desktop-links .group-links { position: absolute; top: calc(100% + .5rem); left: 0; z-index: 10; min-width: 12rem; padding: .5rem; border: 1px solid var(--sl-color-hairline); border-radius: .75rem; background: var(--sl-color-bg-nav); box-shadow: 0 12px 32px #0003; }
  .veetr-header :global(.account-menu-item:has(.portal-account) > a:not(.portal-account)) { display: none; }
  .mobile-menu { display: none; }
  :global(.veetr-header a:focus-visible), summary:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 4px; }
  @media (max-width: 76rem) {
    .desktop-links { display: none; }
    .mobile-menu { display: block; }
    .mobile-menu > summary { display: grid; place-items: center; list-style: none; width: 2.75rem; height: 2.75rem; border: 1px solid var(--sl-color-hairline); border-radius: .6rem; cursor: pointer; color: var(--sl-color-white); }
    .mobile-menu > summary::-webkit-details-marker { display: none; }
    .close-icon, [open] .menu-icon { display: none; }
    [open] .close-icon { display: block; }
    .mobile-menu nav { position: absolute; top: calc(100% + .5rem); right: 1rem; width: min(24rem, calc(100% - 2rem)); max-height: calc(100dvh - var(--sl-nav-height) - 1.5rem); overflow-y: auto; overscroll-behavior: contain; padding: .75rem; border: 1px solid var(--sl-color-hairline); border-radius: .85rem; background: var(--sl-color-bg-nav); box-shadow: 0 20px 60px #0003; }
    .mobile-menu nav :global(a) { display: flex; align-items: center; justify-content: space-between; min-height: 3rem; padding: .65rem 1rem; color: var(--sl-color-white); text-decoration: none; font-weight: 550; border-radius: .45rem; }
    .mobile-menu nav :global(a:hover), .mobile-menu nav :global(a[aria-current="page"]) { background: var(--sl-color-accent-low); color: var(--sl-color-text-accent); }
    .mobile-menu .nav-group > summary { min-height: 3rem; padding: .65rem 1rem; color: var(--sl-color-white); font-size: inherit; }
    .mobile-menu .nav-group.active > summary { color: var(--sl-color-text-accent); }
    .mobile-menu .group-links { margin-left: 1rem; padding-left: .35rem; border-left: 1px solid var(--sl-color-hairline); }
  }
  @media (max-width: 40rem) {
    .veetr-header { gap: .5rem; }
    .header-controls { gap: .15rem; }
    .header-controls :global(site-search) { margin: 0; }
  }
  @media (max-width: 24rem) {
    .veetr-header { gap: .5rem; }
    .veetr-header :global(.site-title) { font-size: 1.2rem; }
    .veetr-header :global(.site-title img) { width: 2rem; height: 2rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.mobile-menu, .nav-group').forEach((menu) => {
    const close = () => { menu.open = false; };
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) close();
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        event.stopPropagation();
        close();
        menu.querySelector('summary')?.focus();
      }
    });
    menu.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) close();
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    window.matchMedia('(max-width: 76rem)').addEventListener('change', close);
  });
</script>
