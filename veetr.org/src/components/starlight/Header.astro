---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import { Icon } from '@astrojs/starlight/components';

const links = [
  { href: '/build/', label: 'Build' },
  { href: '/get-your-veetr/', label: 'Get Your Veetr' },
  { href: '/docs/', label: 'Docs' },
  { href: '/about/', label: 'About' },
];
const pathname = Astro.url.pathname;
---

<div class="veetr-header">
  <SiteTitle />
  <nav class="desktop-links" aria-label="Main navigation">
    {links.map(({ href, label }) => (
      <a href={href} aria-current={pathname === href || (href === '/docs/' && pathname.startsWith('/docs/')) ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
  <div class="header-controls">
    <Search />
    <a class="github-link" href="https://github.com/veetrlabs/veetr" aria-label="Veetr on GitHub">
      <Icon name="github" size="1.25rem" />
    </a>
    <ThemeSelect />
    <details class="mobile-menu">
      <summary aria-label="Site navigation">
        <Icon class="menu-icon" name="list-format" size="1.25rem" />
        <Icon class="close-icon" name="close" size="1.25rem" />
      </summary>
      <nav aria-label="Mobile navigation">
        {links.map(({ href, label }) => (
          <a href={href} aria-current={pathname === href || (href === '/docs/' && pathname.startsWith('/docs/')) ? 'page' : undefined}>{label}</a>
        ))}
        <div class="mobile-actions">
          <a href="https://github.com/veetrlabs/veetr">GitHub <Icon name="external" /></a>
          <a href="https://app.veetr.org/">Live App <Icon name="right-arrow" /></a>
        </div>
      </nav>
    </details>
  </div>
</div>

<style>
  .veetr-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 100%; max-width: 76rem; margin-inline: auto; }
  .veetr-header :global(.site-title) { gap: .6rem; color: var(--sl-color-white); font-size: 1.4rem; font-weight: 750; }
  .veetr-header :global(.site-title img) { height: 2.25rem; width: 2.25rem; }
  .desktop-links, .header-controls { display: flex; align-items: center; gap: .4rem; }
  .header-controls :global(site-search) { margin-inline: .2rem; }
  .desktop-links a { padding: .55rem .7rem; font-size: .9rem; font-weight: 550; text-decoration: none; color: var(--sl-color-gray-2); border-radius: .5rem; white-space: nowrap; }
  .desktop-links a:hover, .desktop-links a[aria-current="page"] { color: var(--sl-color-text-accent); background: var(--sl-color-accent-low); }
  .github-link { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; color: var(--sl-color-white); }
  .mobile-menu { display: none; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 4px; }
  @media (max-width: 64rem) {
    .desktop-links, .github-link { display: none; }
    .mobile-menu { display: block; }
    summary { display: grid; place-items: center; list-style: none; width: 2.75rem; height: 2.75rem; border: 1px solid var(--sl-color-hairline); border-radius: .6rem; cursor: pointer; color: var(--sl-color-white); }
    summary::-webkit-details-marker { display: none; }
    .close-icon, [open] .menu-icon { display: none; }
    [open] .close-icon { display: block; }
    .mobile-menu nav { position: absolute; top: calc(100% + .5rem); right: 1rem; width: min(24rem, calc(100% - 2rem)); max-height: calc(100dvh - var(--sl-nav-height) - 1.5rem); overflow-y: auto; overscroll-behavior: contain; padding: .75rem; border: 1px solid var(--sl-color-hairline); border-radius: .85rem; background: var(--sl-color-bg-nav); box-shadow: 0 20px 60px #0003; }
    .mobile-menu nav a { display: flex; align-items: center; justify-content: space-between; min-height: 3rem; padding: .65rem 1rem; color: var(--sl-color-white); text-decoration: none; font-weight: 550; border-radius: .45rem; }
    .mobile-menu nav a:hover, .mobile-menu nav a[aria-current="page"] { background: var(--sl-color-accent-low); color: var(--sl-color-text-accent); }
    .mobile-actions { border-top: 1px solid var(--sl-color-hairline); margin-top: .5rem; padding-top: .5rem; }
  }
  @media (max-width: 24rem) {
    .veetr-header { gap: .5rem; }
    .veetr-header :global(.site-title) { font-size: 1.2rem; }
    .veetr-header :global(.site-title img) { width: 2rem; height: 2rem; }
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  if (menu) {
    const close = () => { menu.open = false; };
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        close();
        menu.querySelector('summary')?.focus();
      }
    });
    menu.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) close();
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    window.matchMedia('(max-width: 64rem)').addEventListener('change', close);
  }
</script>
