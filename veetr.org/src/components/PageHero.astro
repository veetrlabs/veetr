---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  support?: string;
  image?: string;
  imageAlt?: string;
  compact?: boolean;
}

const { eyebrow, title, lead, support, image, imageAlt = '', compact = false } = Astro.props;
---

<section class:list={['page-hero', compact && 'page-hero-compact']}>
  <div class="shell hero-grid">
    <div class="hero-copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lead && <p class="hero-lead">{lead}</p>}
      {support && <p class="hero-support">{support}</p>}
      <div class="hero-actions">
        <a class="button" href="https://app.veetr.org/">Open Live App</a>
        <a class="button button-secondary" href="/get-your-veetr/">Get Your Veetr</a>
      </div>
    </div>

    {image && (
      <div class="hero-media">
        <img src={image} alt={imageAlt} />
      </div>
    )}
  </div>
</section>
