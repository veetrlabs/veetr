---
import {siteLanguage} from '../i18n/site';
const language = siteLanguage(Astro.url.pathname);
---
<label class="site-language"><span class="sr-only">{language === 'cs' ? 'Jazyk webu' : 'Website language'}</span><select data-site-language aria-label={language === 'cs' ? 'Jazyk webu' : 'Website language'}><option value="en" selected={language === 'en'} lang="en">English</option><option value="cs" selected={language === 'cs'} lang="cs">Čeština</option></select><small data-language-error role="status"></small></label>
<style>
.site-language select{max-width:7.5rem;padding:.5rem .3rem;border:1px solid var(--sl-color-hairline,#344451);border-radius:.5rem;background:var(--sl-color-bg-nav,#0b1722);color:var(--sl-color-white,#e9eff5);font:inherit;font-size:.85rem;min-height:2.75rem}
.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
<script>
import {localizedPath, siteLanguage} from '../i18n/site';
// URLs are authoritative, including when opened from a shared link.
try {localStorage.setItem('veetr.language', siteLanguage(location.pathname));} catch {}
document.querySelectorAll<HTMLSelectElement>('[data-site-language]').forEach(select => {
 select.addEventListener('change', async () => {
  const language = select.value === 'cs' ? 'cs' : 'en';
  const error=select.parentElement?.querySelector<HTMLElement>('[data-language-error]');
  if(error) error.textContent='';
  select.disabled=true;
  try {
   const {supabase}=await import('../features/racing/api');
   const {rememberAccountLanguage}=await import('../features/racing/accountLanguage');
   if(supabase) {
    const {data, error: sessionError}=await supabase.auth.getSession();
    if(sessionError) throw sessionError;
    if(data.session) await rememberAccountLanguage(supabase.auth,data.session.user.id,language);
   }
   try {localStorage.setItem('veetr.language', language);} catch {}
   const url = new URL(location.href);
   url.pathname = localizedPath(url.pathname, language);
   location.assign(url.href);
  } catch {
   select.value=siteLanguage(location.pathname);
   if(error) error.textContent=siteLanguage(location.pathname)==='cs' ? 'Jazyk se nepodařilo uložit. Zkuste to znovu.' : 'Could not save language. Please try again.';
  } finally {select.disabled=false;}

 });
});
</script>
