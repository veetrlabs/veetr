        <lv_label name="aws_value" x="250" y="21" width="142" text="12.8"
                  style_text_color="0x000000" style_bg_opa="0" style_pad_all="0"
                  style_text_align="right" style_text_font="veetr_value_83" />

        <lv_label name="tws_label" x="264" y="109" width="105" text="TWS"
                  style_text_color="0x000000" style_bg_opa="0" style_pad_all="0"
                  style_text_align="right" style_text_font="veetr_annotation_12" />
        <lv_label name="tws_unit" x="376" y="109" text="kt"
                  style_text_color="0x888888" style_bg_opa="0" style_pad_all="0"
                  style_text_font="veetr_annotation_12" />
        <lv_label name="tws_value" x="250" y="120" width="142" text="10.2"
                  style_text_color="0x000000" style_bg_opa="0" style_pad_all="0"
                  style_text_align="right" style_text_font="veetr_value_83" />

        <lv_label name="sog_label" x="264" y="208" width="105" text="SOG"
                  style_text_color="0x000000" style_bg_opa="0" style_pad_all="0"
                  style_text_align="right" style_text_font="veetr_annotation_12" />
