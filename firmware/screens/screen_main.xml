<screen>
    <view style_width="400" style_height="300" style_border_width="0"
          style_bg_color="0xffffff" style_bg_opa="255"
          scrollable="false" scrollbar_mode="off">

        <!-- Compass rings. Dynamic wind geometry is rendered on the device. -->
        <lv_obj name="compass_ring" x="10" y="45" width="224" height="224"
                style_radius="999" style_border_width="3" style_border_color="0x000000"
                style_bg_opa="0" style_pad_all="0" />
        <lv_image name="compass_wind_preview" x="10" y="45" src="compass_wind_art" />
        <!-- Fixed preview heading marker. -->
        <lv_obj name="hi_01" x="122" y="29" width="1" height="2" style_bg_color="0x000000" style_bg_opa="255" style_border_width="0" />
        <lv_obj name="hi_02" x="121" y="31" width="3" height="2" style_bg_color="0x000000" style_bg_opa="255" style_border_width="0" />
        <lv_obj name="hi_03" x="120" y="33" width="5" height="2" style_bg_color="0x000000" style_bg_opa="255" style_border_width="0" />
        <lv_obj name="hi_04" x="119" y="35" width="7" height="2" style_bg_color="0x000000" style_bg_opa="255" style_border_width="0" />
        <lv_obj name="hi_05" x="118" y="37" width="9" height="2" style_bg_color="0x000000" style_bg_opa="255" style_border_width="0" />
        <lv_obj name="hi_06" x="117" y="39" width="11" height="2" style_bg_color="0x000000" style_bg_opa="255" style_border_width="0" />
        <lv_obj name="hi_07" x="116" y="41" width="13" height="2" style_bg_color="0x000000" style_bg_opa="255" style_border_width="0" />
        <lv_obj name="hi_08" x="115" y="43" width="15" height="2" style_bg_color="0x000000" style_bg_opa="255" style_border_width="0" />

        <!-- Compact status rows use the otherwise unused space above and below the rose. -->
        <lv_obj name="gps_bar_1" x="8" y="11" width="3" height="4" style_bg_color="0x000000" style_bg_opa="255" style_border_width="0" />
        <lv_obj name="gps_bar_2" x="13" y="8" width="3" height="7" style_bg_color="0x000000" style_bg_opa="255" style_border_width="0" />
        <lv_obj name="gps_bar_3" x="18" y="5" width="3" height="10" style_bg_color="0x000000" style_bg_opa="255" style_border_width="0" />
        <lv_label name="gps_status" x="26" y="0" text="-68dB  SAT 12  TMP 22C"
                  style_text_color="0x000000" style_bg_opa="0" style_pad_all="0"
                  style_text_font="veetr_annotation_12" />
        <lv_label name="time_status" x="8" y="17" text="12:34:56"
                  style_text_color="0x000000" style_bg_opa="0" style_pad_all="0"
                  style_text_font="veetr_annotation_12" />
        <lv_obj name="battery_outline" x="8" y="31" width="18" height="9" style_bg_opa="0" style_border_width="1" style_border_color="0x000000" style_pad_all="0" />
        <lv_obj name="battery_terminal" x="26" y="34" width="2" height="3" style_bg_color="0x000000" style_bg_opa="255" style_border_width="0" />
        <lv_obj name="battery_fill" x="10" y="33" width="12" height="5" style_bg_color="0x000000" style_bg_opa="255" style_border_width="0" />
        <lv_obj name="battery_bolt_1" x="16" y="33" width="3" height="2" style_bg_color="0xffffff" style_bg_opa="255" style_border_width="0" />
        <lv_obj name="battery_bolt_2" x="14" y="35" width="3" height="2" style_bg_color="0xffffff" style_bg_opa="255" style_border_width="0" />
