+package expo.modules.location
+
+import android.content.Context
+import android.app.job.JobScheduler
+import android.os.Build
+import android.location.LocationManager
+import android.os.PowerManager
+
+/** Bounded, opt-in technical counters. Never accepts coordinates, task IDs or error text. */
+internal object VeetrLocationDiagnostics {
+  private const val PREFS = "veetr_location_diagnostics_v1"
+  private const val DAY_MS = 86400000L
+  private val events = listOf("registered", "requestAccepted", "requestFailed", "broadcast", "fix", "jobScheduled", "jobStarted", "taskDispatched", "taskFinished", "serviceStarted", "serviceStopped")
+  @Volatile var serviceRunning = false
+    private set
+
+  @Synchronized fun setEnabled(context: Context, enabled: Boolean) {
+    val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    if (!enabled) prefs.edit().clear().apply()
+    else if (!prefs.getBoolean("enabled", false)) prefs.edit().clear().putBoolean("enabled", true).putLong("since", System.currentTimeMillis()).apply()
+  }
+
+  @Synchronized fun record(context: Context?, event: String, count: Int = 1, fixTime: Long = 0) {
+    if (event == "serviceStarted") serviceRunning = true
+    if (event == "serviceStopped") serviceRunning = false
+    try {
+      if (context == null || event !in events) return
+      val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+      if (!prefs.getBoolean("enabled", false)) return
+      val now = System.currentTimeMillis()
+      if (now - prefs.getLong("since", now) > DAY_MS) prefs.edit().clear().putBoolean("enabled", true).putLong("since", now).apply()
+      val screenOff = !(context.getSystemService(Context.POWER_SERVICE) as PowerManager).isInteractive
+      val edit = prefs.edit().putLong(event, (prefs.getLong(event, 0) + count).coerceIn(0L, 10000000L)).putLong(event + "At", now)
+      if (screenOff) edit.putLong(event + "ScreenOff", (prefs.getLong(event + "ScreenOff", 0) + count).coerceIn(0L, 10000000L))
+      if (fixTime > 0) edit.putLong("lastFixDelayMs", (now - fixTime).coerceIn(0L, DAY_MS))
+      edit.apply()
+    } catch (_: Exception) { /* Diagnostics must not interrupt location delivery. */ }
+  }
+
+  @Synchronized fun snapshot(context: Context): Map<String, Any?> {
+    val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    val now = System.currentTimeMillis()
+    val enabled = prefs.getBoolean("enabled", false)
+    val valid = enabled && now - prefs.getLong("since", 0) <= DAY_MS
+    val result = mutableMapOf<String, Any?>("enabled" to enabled, "serviceRunning" to serviceRunning)
+    result["windowAgeSeconds"] = if (valid) ((now - prefs.getLong("since", now)) / 1000).coerceIn(0L, 86400L) else null
+    for (event in events) {
+      result[event + "Count"] = if (valid) prefs.getLong(event, 0) else 0L
+      result[event + "ScreenOffCount"] = if (valid) prefs.getLong(event + "ScreenOff", 0) else 0L
+      val at = prefs.getLong(event + "At", 0)
+      result[event + "AgeSeconds"] = if (valid && at > 0) ((now - at) / 1000).coerceIn(0L, 86400L) else null
+    }
+    result["lastFixDelayMs"] = if (valid && prefs.contains("lastFixDelayMs")) prefs.getLong("lastFixDelayMs", 0) else null
+    val power = context.getSystemService(Context.POWER_SERVICE) as PowerManager
+    result["screenInteractive"] = power.isInteractive
+    result["powerSave"] = power.isPowerSaveMode
+    result["deviceIdle"] = power.isDeviceIdleMode
+    result["batteryExempt"] = power.isIgnoringBatteryOptimizations(context.packageName)
+    val manager = context.getSystemService(Context.LOCATION_SERVICE) as LocationManager
+    result["gpsProviderEnabled"] = manager.isProviderEnabled(LocationManager.GPS_PROVIDER)
+    result["networkProviderEnabled"] = manager.isProviderEnabled(LocationManager.NETWORK_PROVIDER)
+    val scheduler = context.getSystemService(Context.JOB_SCHEDULER_SERVICE) as JobScheduler
+    val jobs = scheduler.allPendingJobs.filter { it.service.className == "expo.modules.taskManager.TaskJobService" }
+    result["pendingJobs"] = jobs.size
+    result["quotaBlockedJobs"] = if (Build.VERSION.SDK_INT >= 36) jobs.count {
+      scheduler.getPendingJobReasons(it.id).contains(JobScheduler.PENDING_JOB_REASON_QUOTA)
+    } else null
+    return result
+  }
+}
