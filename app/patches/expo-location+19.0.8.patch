+package expo.modules.location
+
+import android.content.Context
+import android.app.ActivityManager
+import org.json.JSONArray
+import org.json.JSONObject
+import android.app.job.JobScheduler
+import android.os.Build
+import android.location.LocationManager
+import android.os.PowerManager
+
+/** Bounded, opt-in technical counters. Never accepts coordinates, task IDs or error text. */
+internal object VeetrLocationDiagnostics {
+  private const val PREFS = "veetr_location_diagnostics_v1"
+  private const val DAY_MS = 86400000L
+  private const val RETENTION_MS = 7 * DAY_MS
+  private var processObserved = false
+  private val journalEvents = setOf("registered", "requestAccepted", "requestFailed", "serviceStarted", "serviceStopped", "serviceStopRequested", "taskRemoved", "jobStopped", "tripStarted", "tripStopped", "resume", "recovery", "jsForeground", "jsTask", "saved", "storageFailed")
+  private val events = listOf("registered", "requestAccepted", "requestFailed", "broadcast", "fix", "jobScheduled", "jobStarted", "taskDispatched", "taskFinished", "serviceStarted", "serviceStopped")
+  @Volatile var serviceRunning = false
+    private set
+
+  @Synchronized fun setEnabled(context: Context, enabled: Boolean) {
+    val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    if (!enabled) { prefs.edit().clear().apply(); processObserved = false }
+    else if (!prefs.getBoolean("enabled", false)) prefs.edit().clear().putBoolean("enabled", true).putLong("since", System.currentTimeMillis()).apply()
+  }
+
+  @Synchronized fun record(context: Context?, event: String, count: Int = 1, fixTime: Long = 0) {
+    if (event == "serviceStarted") serviceRunning = true
+    if (event == "serviceStopped") serviceRunning = false
+    try {
+      if (context == null || (event !in events && event !in journalEvents)) return
+      val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+      if (!prefs.getBoolean("enabled", false)) return
+      val now = System.currentTimeMillis()
+      if (event == "tripStopped" && !prefs.getBoolean("tripActive", false)) return
+      // Never reset on the first fix after a gap: it is the evidence we need.
+      if (!processObserved) {
+        processObserved = true
+        journal(context, "processStarted", now)
+        if (Build.VERSION.SDK_INT >= 30) {
+          val manager = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+          val since = maxOf(prefs.getLong("since", now), prefs.getLong("lastExitAt", 0))
+          manager.getHistoricalProcessExitReasons(context.packageName, 0, 5)
+            .filter { it.timestamp > since && now - it.timestamp <= RETENTION_MS }
+            .sortedBy { it.timestamp }.forEach {
+              // Only Android's numeric reason; never descriptions, traces, PID or process name.
+              journal(context, "processExit", it.timestamp, it.reason, historical = true)
+              prefs.edit().putLong("lastExitAt", it.timestamp).apply()
+            }
+        }
+      }
+      if (event in setOf("resume", "recovery", "jobStarted") || now - prefs.getLong("checkpointAt", 0) >= 600000) pendingHistory(context)
+      val previous = prefs.getLong("savedAt", prefs.getLong("tripStartedAt", 0))
+      if (prefs.getBoolean("tripActive", false) && previous > 0 && now - previous > 45000 &&
+        previous != prefs.getLong("gapSavedAt", 0)) {
+        journal(context, "gap", now)
+        prefs.edit().putLong("gapSavedAt", previous).apply()
+      }
+      val screenOff = !(context.getSystemService(Context.POWER_SERVICE) as PowerManager).isInteractive
+      val edit = prefs.edit().putLong(event, (prefs.getLong(event, 0) + count).coerceIn(0L, 10000000L)).putLong(event + "At", now)
+      if (screenOff) edit.putLong(event + "ScreenOff", (prefs.getLong(event + "ScreenOff", 0) + count).coerceIn(0L, 10000000L))
+      if (fixTime > 0) edit.putLong("lastFixDelayMs", (now - fixTime).coerceIn(0L, DAY_MS))
+      if (event == "tripStarted") edit.putBoolean("tripActive", true).remove("savedAt").remove("gapSavedAt")
+      if (event == "tripStopped") edit.putBoolean("tripActive", false)
+      edit.apply()
+      if (event in journalEvents && event !in setOf("jsForeground", "jsTask", "saved")) journal(context, event, now, if (event == "jobStopped") count else null)
+      else if (now - prefs.getLong("checkpointAt", 0) >= 600000) {
+        journal(context, "checkpoint", now)
+        prefs.edit().putLong("checkpointAt", now).apply()
+      }
+    } catch (_: Exception) { /* Diagnostics must not interrupt location delivery. */ }
+  }
+
+  @Synchronized fun snapshot(context: Context): Map<String, Any?> {
+    val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    val now = System.currentTimeMillis()
+    val enabled = prefs.getBoolean("enabled", false)
+    val valid = enabled
+    val result = mutableMapOf<String, Any?>("enabled" to enabled, "serviceRunning" to serviceRunning)
+    result["windowAgeSeconds"] = if (valid) ((now - prefs.getLong("since", now)) / 1000).coerceIn(0L, 10000000L) else null
+    for (event in events) {
+      result[event + "Count"] = if (valid) prefs.getLong(event, 0) else 0L
+      result[event + "ScreenOffCount"] = if (valid) prefs.getLong(event + "ScreenOff", 0) else 0L
+      val at = prefs.getLong(event + "At", 0)
+      result[event + "AgeSeconds"] = if (valid && at > 0) ((now - at) / 1000).coerceIn(0L, 10000000L) else null
+    }
+    result["lastFixDelayMs"] = if (valid && prefs.contains("lastFixDelayMs")) prefs.getLong("lastFixDelayMs", 0) else null
+    val power = context.getSystemService(Context.POWER_SERVICE) as PowerManager
+    result["screenInteractive"] = power.isInteractive
+    result["powerSave"] = power.isPowerSaveMode
+    result["deviceIdle"] = power.isDeviceIdleMode
+    result["batteryExempt"] = power.isIgnoringBatteryOptimizations(context.packageName)
+    val manager = context.getSystemService(Context.LOCATION_SERVICE) as LocationManager
+    result["gpsProviderEnabled"] = manager.isProviderEnabled(LocationManager.GPS_PROVIDER)
+    result["networkProviderEnabled"] = manager.isProviderEnabled(LocationManager.NETWORK_PROVIDER)
+    val scheduler = context.getSystemService(Context.JOB_SCHEDULER_SERVICE) as JobScheduler
+    val jobs = scheduler.allPendingJobs.filter { it.service.className == "expo.modules.taskManager.TaskJobService" }
+    result["pendingJobs"] = jobs.size
+    result["quotaBlockedJobs"] = if (Build.VERSION.SDK_INT >= 36) jobs.count {
+      scheduler.getPendingJobReasons(it.id).contains(JobScheduler.PENDING_JOB_REASON_QUOTA)
+    } else null
+    return result
+  }
+
+  // Independent of JS/JobScheduler. All fields are fixed technical values.
+  private fun journal(context: Context, event: String, at: Long, reason: Int? = null, historical: Boolean = false) {
+    val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    val now = System.currentTimeMillis()
+    val old = JSONArray(prefs.getString("history", "[]"))
+    val kept = mutableListOf<JSONObject>()
+    for (i in 0 until old.length()) {
+      val row = old.getJSONObject(i)
+      if (now - row.getLong("at") <= RETENTION_MS) kept.add(row)
+    }
+    val savedAt = prefs.getLong("savedAt", 0)
+    val scheduler = context.getSystemService(Context.JOB_SCHEDULER_SERVICE) as JobScheduler
+    val quotaBlocked: Any = if (!historical && Build.VERSION.SDK_INT >= 36) scheduler.allPendingJobs.any {
+      it.service.className == "expo.modules.taskManager.TaskJobService" &&
+        scheduler.getPendingJobReasons(it.id).contains(JobScheduler.PENDING_JOB_REASON_QUOTA)
+    } else JSONObject.NULL
+    if (kept.any { it.getLong("at") == at && it.getString("event") == event && it.optInt("reason", -1000) == (reason ?: -1000) }) return
+    kept.add(JSONObject().apply {
+      put("at", at); put("event", event)
+      put("fixes", if (historical) JSONObject.NULL else prefs.getLong("fix", 0))
+      put("callbacks", if (historical) JSONObject.NULL else (prefs.getLong("jsForeground", 0) + prefs.getLong("jsTask", 0)).coerceAtMost(10000000L))
+      put("saved", if (historical) JSONObject.NULL else prefs.getLong("saved", 0))
+      put("taskStarts", if (historical) JSONObject.NULL else prefs.getLong("jobStarted", 0))
+      put("savedAgeSeconds", if (historical || savedAt == 0L) JSONObject.NULL else ((now - savedAt) / 1000).coerceIn(0L, 10000000L))
+      put("reason", reason ?: JSONObject.NULL)
+      put("quotaBlocked", if (historical) JSONObject.NULL else quotaBlocked)
+      put("screenOff", if (historical) JSONObject.NULL else !(context.getSystemService(Context.POWER_SERVICE) as PowerManager).isInteractive)
+    })
+    val bounded = JSONArray()
+    kept.sortedBy { it.getLong("at") }.takeLast(1024).forEach { bounded.put(it) }
+    prefs.edit().putString("history", bounded.toString()).apply()
+  }
+
+  private fun pendingHistory(context: Context) {
+    if (Build.VERSION.SDK_INT < 36) return
+    try {
+      val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+      if (!prefs.getBoolean("enabled", false)) return
+      val scheduler = context.getSystemService(Context.JOB_SCHEDULER_SERVICE) as JobScheduler
+      val now = System.currentTimeMillis()
+      scheduler.allPendingJobs.filter { it.service.className == "expo.modules.taskManager.TaskJobService" }.forEach { job ->
+        // Query before recovery can cancel the job. Job IDs never enter the journal.
+        try {
+          scheduler.getPendingJobReasonsHistory(job.id).takeLast(16).forEach { info ->
+            if (info.timestampMillis >= prefs.getLong("since", now) && now - info.timestampMillis in 0..RETENTION_MS) {
+              info.pendingJobReasons.filter { it >= 0 }.distinct().forEach { reason ->
+                journal(context, "jobPending", info.timestampMillis, reason, historical = true)
+              }
+            }
+          }
+        } catch (_: Exception) { /* A completed job may disappear between calls. */ }
+      }
+    } catch (_: Exception) { /* Unsupported/OEM implementations must not affect recording. */ }
+  }
+
+  @Synchronized fun history(context: Context): List<Map<String, Any?>> {
+    val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    if (!prefs.getBoolean("enabled", false)) return emptyList()
+    val now = System.currentTimeMillis()
+    pendingHistory(context)
+    val rows = JSONArray(prefs.getString("history", "[]"))
+    val result = mutableListOf<Map<String, Any?>>()
+    for (i in 0 until rows.length()) {
+      val row = rows.getJSONObject(i)
+      if (now - row.getLong("at") > RETENTION_MS) continue
+      val entry = mutableMapOf<String, Any?>("ageSeconds" to ((now - row.getLong("at")) / 1000).coerceIn(0L, 604800L))
+      for (key in listOf("event", "fixes", "callbacks", "saved", "taskStarts", "savedAgeSeconds", "reason", "screenOff", "quotaBlocked"))
+        entry[key] = if (row.isNull(key)) null else row.get(key)
+      result.add(entry)
+    }
+    // Preserve recent failure/lifecycle evidence first, then the periodic trip samples.
+    val critical = result.filter { it["event"] != "checkpoint" }.takeLast(32)
+    val samples = result.filter { it["event"] == "checkpoint" }
+    val slots = 64 - critical.size
+    // Evenly sample the window, retaining both endpoints of long trips.
+    val checkpoints = if (samples.size <= slots) samples else (0 until slots).map { samples[it * (samples.size - 1) / (slots - 1)] }
+    return (critical + checkpoints).sortedByDescending { it["ageSeconds"] as Long }
+  }
+
+}
