EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Public website used to create/reset an account and view the live map.
EXPO_PUBLIC_SITE_URL=https://veetr.org
# Required for Android native maps. Configure this in the EAS build environment too.
# Restrict it to Maps SDK for Android, com.veetr.app, and the signing certificate.
GOOGLE_MAPS_ANDROID_API_KEY=
