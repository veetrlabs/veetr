{
  "expo": {
    "name": "Veetr",
    "slug": "veetr",
    "owner": "veetrlabs",
    "version": "0.0.28",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f5f5"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Connect to Veetr sailing sensor",
        "NSBluetoothPeripheralUsageDescription": "Communicate with Veetr device",
        "UIBackgroundModes": [
          "location",
          "bluetooth-central"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.veetr.mobile",
      "associatedDomains": [
        "applinks:veetr.org"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5f5f5"
      },
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.veetr.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "veetr.org",
              "pathPrefix": "/join/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "scheme": "veetr",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "react-native-ble-plx",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your phone GPS to track your boat during a regatta.",
          "locationAlwaysAndWhenInUsePermission": "Share your boat position during an active tracking session, including while the screen is locked.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Use motion sensors to reduce GPS speed drift when your phone is stationary."
        }
      ],
      "./plugins/with-ios-pod-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f16c672e-a176-4a02-b145-5ba72c00535f"
      }
    }
  }
}
